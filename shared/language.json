{
  "$comment": [
    "Single source of truth for every editor-side Beans language asset.",
    "",
    "The compiler owns this data. Each list below records where it comes from",
    "in the beans repository so `npm run sync -- --beans <path>` can prove the",
    "two are still in step. Do not hand-edit a generated file; edit this one",
    "and run `npm run generate`.",
    "",
    "Language intelligence (completion, hover, diagnostics, ...) is NOT here.",
    "That lives in `beansc lsp` and reaches editors over LSP."
  ],
  "language": {
    "id": "beans",
    "name": "Beans",
    "version": "0.1.0",
    "fileExtensions": [
      ".b"
    ],
    "fileNames": [
      "beans.pot"
    ],
    "$comment": "beans.pot is an exact filename. `.pot` is gettext's; never claim the suffix."
  },
  "comments": {
    "line": "//",
    "doc": "///",
    "docIsNotDivider": "////",
    "blockStart": "/*",
    "blockEnd": "*/",
    "blockNesting": true,
    "source": "beans/compiler/bootstrap/lexer.cpp — skip_block_comment(), scan_all()"
  },
  "strings": {
    "quote": "\"",
    "escapes": [
      "\\n",
      "\\t",
      "\\r",
      "\\0",
      "\\\\",
      "\\\"",
      "\\{",
      "\\}"
    ],
    "interpolation": {
      "open": "{",
      "close": "}",
      "nestable": true,
      "maxDepth": 16
    },
    "formatSpecSeparator": ":",
    "multiline": false,
    "source": "beans/compiler/bootstrap/lexer.cpp — consume_string_body(), split_fmt_spec()"
  },
  "numbers": {
    "digitSeparator": "_",
    "hexPrefixes": [
      "0x",
      "0X"
    ],
    "binaryPrefixes": [
      "0b",
      "0B"
    ],
    "exponent": [
      "e",
      "E"
    ],
    "source": "beans/compiler/bootstrap/lexer.cpp — scan_number()"
  },
  "keywords": {
    "$comment": [
      "The 33 reserved spellings, in declaration order, straight from the",
      "compiler's keyword table. `unique` and `super` are contextual and live",
      "in contextualKeywords below."
    ],
    "source": "beans/compiler/bootstrap/token.cpp — keyword_or_ident()",
    "reserved": [
      "class",
      "struct",
      "union",
      "interface",
      "enum",
      "fn",
      "let",
      "var",
      "pub",
      "override",
      "if",
      "else",
      "for",
      "in",
      "match",
      "return",
      "break",
      "continue",
      "import",
      "as",
      "defer",
      "unsafe",
      "extern",
      "new",
      "extends",
      "implements",
      "static",
      "move",
      "take",
      "inout",
      "self",
      "true",
      "false"
    ],
    "deprecated": {
      "take": "Reserved and lexed, but the parser rejects it: \"'take' was removed — use 'move'\". See beans/compiler/bootstrap/parser.cpp — parse_unary()."
    },
    "byRole": {
      "declaration": [
        "class",
        "struct",
        "union",
        "interface",
        "enum",
        "fn",
        "let",
        "var"
      ],
      "modifier": [
        "pub",
        "override",
        "static",
        "extern",
        "unsafe",
        "move",
        "take",
        "inout"
      ],
      "control": [
        "if",
        "else",
        "for",
        "in",
        "match",
        "return",
        "break",
        "continue",
        "defer"
      ],
      "operatorLike": [
        "as",
        "new"
      ],
      "relation": [
        "extends",
        "implements"
      ],
      "import": [
        "import"
      ],
      "variable": [
        "self"
      ],
      "constant": [
        "true",
        "false"
      ]
    }
  },
  "contextualKeywords": {
    "$comment": [
      "Not reserved — an ordinary identifier in any other position. Highlight",
      "them, but never treat them as reserved words.",
      "",
      "`recognizedWhen` is the exact shape the compiler's parser tests for.",
      "It is the contract for every generated highlighting rule: outside that",
      "shape the word is a name, and painting it as a keyword is a bug. The",
      "compiler's own sources are the proof — `compiler/beans/module.b` has a",
      "local called `package`, `compiler/beans/layout.b` a field called",
      "`align` — so any rule that over-matches breaks the compiler's own",
      "highlighting."
    ],
    "source": "beans/spec/SYNTAX.md — 'Keywords and modifiers', 'Decided'; beans/compiler/bootstrap/parser.cpp — parse_decl(), parse_stmt(), parse_await(), at_package_clause()",
    "modifiers": [
      "unique",
      "packed",
      "align",
      "feature",
      "opaque",
      "async"
    ],
    "variables": [
      "super"
    ],
    "typeOperators": [
      "size_of",
      "align_of",
      "offset_of"
    ],
    "declarations": [
      "package"
    ],
    "expressionOperators": [
      "await"
    ],
    "recognizedWhen": {
      "unique": "immediately before `class`",
      "packed": "immediately before `struct` or `union`",
      "opaque": "immediately before `struct`",
      "align": "immediately before `(` — `align(8)`; a field named `align` reads `align:`",
      "feature": "immediately before a string literal — `feature \"aes\" fn`",
      "async": "immediately before `fn`, or the exact pair `async let` inside an async body",
      "await": "prefix of an expression, inside an async body only",
      "package": "`package <name>`, before every import and declaration in a file",
      "super": "a receiver inside a method of a class that extends another",
      "size_of": "immediately before `(`",
      "align_of": "immediately before `(`",
      "offset_of": "immediately before `(`"
    }
  },
  "notKeywords": {
    "$comment": "Called out because they look like keywords in other languages but are ordinary names in Beans.",
    "source": "beans/spec/SYNTAX.md — 'Keywords and modifiers'",
    "names": [
      "some",
      "none",
      "ok",
      "err",
      "spawn"
    ]
  },
  "types": {
    "source": "beans/spec/SYNTAX.md — 'Types'; beans/compiler/bootstrap/checker.cpp — builtin_generic_classes_",
    "primitives": [
      "int",
      "i8",
      "i16",
      "i32",
      "i64",
      "u8",
      "u16",
      "u32",
      "u64",
      "float",
      "f32",
      "f64",
      "decimal",
      "bool",
      "string",
      "byte"
    ],
    "genericClasses": [
      "List",
      "Map",
      "OrderedMap",
      "Thread",
      "Mutex",
      "Channel",
      "Box",
      "Arena",
      "Shared",
      "Weak",
      "RawPtr",
      "Slice",
      "Atomic",
      "StoredCallback"
    ],
    "builtinClasses": [
      "Bytes",
      "File",
      "Dir",
      "MMap",
      "Error"
    ],
    "builtinEnums": [
      "Option",
      "Result",
      "AtomicInt",
      "CpuFeature",
      "RoundingMode",
      "MemoryOrder"
    ],
    "simdTypePattern": "^(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)x[0-9]+$",
    "unit": "unit"
  },
  "operators": {
    "$comment": "Longest-match order preserved; a generator must not reorder these.",
    "source": "beans/compiler/bootstrap/lexer.cpp — scan_all(); beans/compiler/bootstrap/token.cpp — to_string()",
    "assignment": [
      "=",
      "+=",
      "-=",
      "*=",
      "/=",
      "%="
    ],
    "comparison": [
      "==",
      "!=",
      "<=",
      ">=",
      "<",
      ">"
    ],
    "logical": [
      "&&",
      "||",
      "!"
    ],
    "arithmetic": [
      "+",
      "-",
      "*",
      "/",
      "%"
    ],
    "bitwise": [
      "&",
      "|",
      "^",
      "~",
      "<<",
      ">>"
    ],
    "range": [
      "..=",
      ".."
    ],
    "arrow": [
      "->",
      "=>"
    ],
    "other": [
      ".",
      "?",
      "@",
      ":",
      ",",
      ";"
    ]
  },
  "brackets": {
    "pairs": [
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "{",
        "close": "}"
      }
    ],
    "autoClose": [
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ]
  },
  "statements": {
    "terminator": "newline",
    "semicolons": false,
    "$comment": "Go-style: a newline ends a statement only after a token that can end one, so `} else {` must be on one line.",
    "source": "beans/compiler/bootstrap/lexer.cpp — ends_statement()"
  },
  "manifest": {
    "fileName": "beans.pot",
    "keywords": [
      "module",
      "kind",
      "require",
      "link",
      "search",
      "library",
      "framework"
    ],
    "kinds": [
      "application",
      "library"
    ],
    "source": "beans/spec/SYNTAX.md — 'Files, modules, imports'"
  },
  "languageServer": {
    "$comment": [
      "The compiler is the only language engine. Editor clients must not add a",
      "second one — they negotiate these capabilities over LSP and render them."
    ],
    "command": "beansc",
    "args": [
      "lsp"
    ],
    "source": "beans/compiler/beans/lsp_server.b — lsp_capabilities(), dispatch(); the bootstrap's beans/compiler/bootstrap/lspserver.cpp advertises the subset marked below",
    "capabilities": [
      "textDocumentSync (incremental, openClose, save)",
      "hoverProvider",
      "signatureHelpProvider",
      "completionProvider",
      "definitionProvider",
      "declarationProvider",
      "typeDefinitionProvider",
      "implementationProvider",
      "referencesProvider",
      "documentHighlightProvider",
      "documentSymbolProvider",
      "workspaceSymbolProvider",
      "callHierarchyProvider",
      "typeHierarchyProvider",
      "semanticTokensProvider (full)",
      "renameProvider (prepareProvider)"
    ],
    "completionTriggerCharacters": [
      "."
    ],
    "signatureHelpTriggerCharacters": [
      "(",
      ","
    ],
    "semanticTokens": {
      "$comment": [
        "The two compiler implementations advertise different legends today.",
        "Editors must not hardcode either one — they negotiate the legend at",
        "initialize. `all` is the union, and it is what the clients ship style",
        "mappings for, so whichever build a user has, every token type the",
        "server sends already has a style.",
        "",
        "The invariant the test enforces is a subset check: every type the",
        "running server advertises must appear in `all`. See",
        "editors/test/lsp-smoke.test.mjs."
      ],
      "bootstrap": {
        "source": "beans/compiler/bootstrap/lsp.cpp — semantic_token_types()",
        "types": [
          "type",
          "function",
          "method",
          "parameter",
          "variable",
          "property",
          "enum",
          "enumMember"
        ]
      },
      "selfHosted": {
        "source": "beans/compiler/beans/lsp_server.b — lsp_capabilities()'s tokenTypes",
        "types": [
          "type",
          "function",
          "variable",
          "property",
          "enumMember",
          "keyword"
        ]
      },
      "all": [
        "type",
        "function",
        "method",
        "parameter",
        "variable",
        "property",
        "enum",
        "enumMember",
        "keyword"
      ],
      "modifiers": []
    },
    "bootstrapCapabilities": {
      "$comment": [
        "The C++ stage-0 server is bootstrap-only and advertises the original,",
        "smaller set. Clients negotiate at initialize and must not assume either",
        "list; this one records what the older server still answers so a user on a",
        "stage-0 build gets no broken menu entries."
      ],
      "capabilities": [
        "textDocumentSync (full)",
        "hoverProvider",
        "signatureHelpProvider",
        "completionProvider",
        "definitionProvider",
        "referencesProvider",
        "documentSymbolProvider",
        "semanticTokensProvider (full)",
        "renameProvider (prepareProvider)"
      ]
    }
  }
}

{
  "name": "tree-sitter-beans",
  "version": "0.1.2",
  "description": "Beans grammar for tree-sitter",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/beans-lang/editors.git",
    "directory": "tree-sitter-beans"
  },
  "keywords": [
    "parser",
    "tree-sitter",
    "beans"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "grammar.js",
    "grammar-data.json",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "tree-sitter": [
    {
      "scope": "source.beans",
      "file-types": [
        "b"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^beans$"
    }
  ],
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.11"
  }
}
